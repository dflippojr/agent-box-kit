$ (cd ~/sample-lib) echo "# description written from .github/pull_request_template.md"; grep -n "^#" .github/pull_request_template.md; mkdir -p ~/notes && cat > ~/notes/box-setup.md <<X
## What and why

Set up the agent box: AGENTS.md, the box profile, and the items box-bootstrap writes.

Closes #1

## Proof

| Acceptance criterion | How verified | Evidence |
|---|---|---|
| The gate runs the tests | python3 scripts/check.py | 2 passed, GATE_PASS |

### Not verified

The hosted checks: they run when the pull request opens.

### Gate changes

Adds the gate: scripts/check.py, scripts/tamper_guard.py, scripts/pr_body_lint.py and the two workflows.
X
echo "# NOT WALKED: push and open the pull request; required checks; the gate-change-approved label (GitHub account). Local stand-in: the commands pr-checks.yml runs"; grep -n "run:" -A2 .github/workflows/pr-checks.yml | grep "python"
python3 scripts/tamper_guard.py --base main; echo rc=$?
python3 scripts/tamper_guard.py --base main --approved | tail -1; echo rc=$?
printf "%s\n" "$(cat ~/notes/box-setup.md)" | python3 scripts/pr_body_lint.py -; echo rc=$?
python3 scripts/check.py | tail -1
